{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "opencode-go/hy4-flash-free",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push *": "ask",
      "rtk git push *": "ask",
      "git reset --hard*": "ask",
      "rtk git reset --hard*": "ask",
      "rm -rf *": "ask"
    },
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask"
    }
  },
  "agent": {
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "variant": "low"
    },
    "plan": {
      "model": "opencode-go/glm-5.3"
    },
    "review": {
      "model": "opencode-go/glm-5.3",
      "description": "Read-only diff and architecture reviewer",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": {
          "*": "ask",
          "git diff*": "allow",
          "git log*": "allow",
          "git status*": "allow"
        }
      }
    }
  }
}
